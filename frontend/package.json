{
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-table": "^8.21.3",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.47.0",
    "next": "^16.3.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sonner": "^2.0.8",
    "zustand": "^5.0.15"
  },
  "description": "Multiprofile Linux \u2014 premium desktop console frontend (Next.js static export, served by the Flask backend)",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2"
  },
  "name": "multiprofile-console",
  "private": true,
  "scripts": {
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "export": "NEXT_TELEMETRY_DISABLED=1 next build",
    "lint": "eslint src --max-warnings=0",
    "publish": "NEXT_TELEMETRY_DISABLED=1 next build && node scripts/sync-static.mjs",
    "typecheck": "tsc --noEmit",
    "check-static": "node scripts/check-static-fresh.mjs"
  },
  "version": "1.9.0",
  "overrides": {
    "source-map-js": "^1.2.2",
    "sharp": "^0.35.5"
