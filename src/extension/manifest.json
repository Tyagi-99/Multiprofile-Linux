{
  "manifest_version": 3,
  "name": "Multiprofile Identity Manager",
  "version": "1.4.0",
  "description": "Applies this profile's fingerprint configuration, cookies and proxy authentication. Audio is not spoofed — see fingerprint/audio.py.",
  "permissions": [
    "scripting",
    "cookies",
    "proxy",
    "storage",
    "alarms",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "evasion.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
